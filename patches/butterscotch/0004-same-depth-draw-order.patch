diff --git a/src/runner.c b/src/runner.c
index 2184fae..0f179c2 100644
--- a/src/runner.c
+++ b/src/runner.c
@@ -688,8 +688,10 @@ static int compareDrawKeys(const DrawKey* a, const DrawKey* b) {
