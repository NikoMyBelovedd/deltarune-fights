+// deltaruneWEB replays: key events are recorded with the frame they were applied on, and played back exactly.
+typedef struct { int32_t frame; int32_t vk; int32_t down; } DrInput;
+static DrInput* gRec = nullptr;
+static int32_t gRecCount = 0;
+static int32_t gRecCap = 0;
+static int gRecording = 0;
+static DrInput* gPlay = nullptr;
+static int32_t gPlayCount = 0;
+static int32_t gPlayPos = 0;
+static int gPlayback = 0;
+
+static void recordInput(int32_t frame, int32_t vk, int32_t down) {
+    if (!gRecording) return;
+    if (gRecCount == gRecCap) {
+        gRecCap = gRecCap ? gRecCap * 2 : 1024;
+        gRec = (DrInput*) realloc(gRec, (size_t) gRecCap * sizeof(DrInput));
+    }
+    gRec[gRecCount++] = (DrInput) { frame, vk, down };
+}
+
+void setRecording(int on) { gRecording = on; gRecCount = 0; }
+int32_t getRecordCount(void) { return gRecCount; }
+DrInput* getRecordPtr(void) { return gRec; }
+// events must stay allocated (JS mallocs them) and be sorted by frame.
+void setPlayback(DrInput* events, int32_t count) { gPlay = events; gPlayCount = count; gPlayPos = 0; gPlayback = 1; }
+int32_t getFrame(void) { return gRunner ? (int32_t) gRunner->frameCount : 0; }
+
+// deltaruneWEB: freeze the game loop (no steps, no draws) while the page shows its pause menu.
+void setPaused(int paused) {
+    gPaused = paused;
+}
 
